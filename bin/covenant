"""covenant"""

__version__ = '0.0.79'

# TODO: load Python logging configuration (using standard logging.config)

import argparse
import logging
import grp
import os
import pwd
import six

from dwho.modules import * # XXX
from dwho.config import (init_logger,
                         make_piddir,
                         make_logdir,
                         set_softname,
                         set_softver)
from httpdis import httpdis
from sonicprobe.libs import daemonize

from covenant.classes.config import DWHO_THREADS, load_conf, start_endpoints
from covenant.filters import * # XXX
from covenant.modules import * # XXX
from covenant.plugins import * # XXX


SYSLOG_NAME      = "covenant"
LOG              = logging.getLogger(SYSLOG_NAME)

DEFAULT_PIDFILE  = "/run/covenant/covenant.pid"
DEFAULT_LOGFILE  = "/var/log/covenant/daemon.log"
DEFAULT_USER     = "covenant"
DEFAULT_GROUP    = "covenant"

COVENANT_USER    = os.environ.get('COVENANT_USER') or None
COVENANT_GROUP   = os.environ.get('COVENANT_GROUP') or None
COVENANT_PIDFILE = os.environ.get('COVENANT_PIDFILE') or DEFAULT_PIDFILE
COVENANT_LOGFILE = os.environ.get('COVENANT_LOGFILE') or DEFAULT_LOGFILE


def argv_parse_check():
    """
    Parse (and check a little) command line parameters
    """
    parser        = argparse.ArgumentParser()

    parser.add_argument("-l",
                        dest      = 'loglevel',
                        default   = 'info',   # warning: see affectation under
                        choices   = ('critical', 'error', 'warning', 'info', 'debug'),
                        help      = ("Emit traces with LOGLEVEL details, must be one of:\t"
                                     "critical, error, warning, info, debug"))
    parser.add_argument("-d",
                        action    = 'store_true',
                        dest      = 'dontlauchmain',
                        default   = False,
                        help      = "Don't call the main function, for installation test purposes")
    parser.add_argument("-f",
                        action    = 'store_true',
                        dest      = 'foreground',
                        default   = False,
                        help      = "Foreground, don't daemonize")
    parser.add_argument("-c",
                        dest      = 'conffile',
                        type      = six.ensure_text,
                        default   = '/etc/covenant/covenant.yml',
                        help      = "Use configuration file <conffile> instead of %(default)s")
    parser.add_argument("-p",
                        dest      = 'pidfile',
                        type      = six.ensure_text,
                        default   = COVENANT_PIDFILE,
                        help      = "Use PID file <pidfile> instead of %(default)s")
    parser.add_argument("-u",
                        dest      = 'username',
                        type      = six.ensure_text,
                        default   = COVENANT_USER,
                        help      = "Service user (default: COVENANT_USER or covenant)")
    parser.add_argument("-g",
                        dest      = 'groupname',
                        type      = six.ensure_text,
                        default   = COVENANT_GROUP,
                        help      = "Service group (default: COVENANT_GROUP or covenant)")
    parser.add_argument("--logfile",
                        dest      = 'logfile',
                        type      = six.ensure_text,
                        default   = COVENANT_LOGFILE,
                        help      = "Use log file <logfile> instead of %(default)s")
    parser.add_argument("--listen-addr",
                        dest      = 'listen_addr',
                        type      = six.ensure_text,
                        help      = "Listen on address <listen_addr>")
    parser.add_argument("--listen-port",
                        dest      = 'listen_port',
                        type      = int,
                        help      = "Listen on port <listen_port>")

    args          = parser.parse_args()
    args.loglevel = getattr(logging, args.loglevel.upper(), logging.INFO)

    return args


def service_identity(options):
    username = options.username
    groupname = options.groupname
    if os.geteuid() == 0:
        username = username or DEFAULT_USER
        groupname = groupname or DEFAULT_GROUP
    try:
        user = pwd.getpwnam(username) if username else pwd.getpwuid(os.geteuid())
    except KeyError:
        raise SystemExit("unknown service user %r" % (username or os.geteuid()))
    try:
        group = grp.getgrnam(groupname) if groupname else grp.getgrgid(os.getegid())
    except KeyError:
        raise SystemExit("unknown service group %r" % (groupname or os.getegid()))
    return user, group.gr_gid


def run_detached(options, user, gid, root_logger):
    # Sonicprobe detaches before HTTPdis binds. Wait for the serving loop so
    # the original launcher can report bind, PID and privilege failures.
    reader, writer = os.pipe()
    pid = os.fork()
    if pid:
        os.close(writer)
        try:
            ready = os.read(reader, 1)
        finally:
            os.close(reader)
            os.waitpid(pid, 0)
        if ready != b'1':
            raise SystemExit(1)
        return

    os.close(reader)
    with os.fdopen(writer, 'wb', 0) as startup:
        daemonize.daemonize()

        class ReadyServer(httpdis.KillableThreadingHTTPServer):
            def serve_until_killed(self):
                if not startup.closed:
                    startup.write(b'1')
                    startup.close()
                return super(ReadyServer, self).serve_until_killed()

        serve(options, user, gid, root_logger, ReadyServer)


def main(options):
    """
    Main function; start the server
    """
    set_softname(SYSLOG_NAME)
    set_softver(__version__)

    user, gid = service_identity(options)
    uid = user.pw_uid

    make_piddir(options.pidfile, uid, gid)
    make_logdir(options.logfile, uid, gid)

    root_logger = init_logger(options.logfile, SYSLOG_NAME)
    options     = load_conf(options.conffile, options)

    setattr(options, 'server_version', "%s/%s" % (SYSLOG_NAME, __version__))
    setattr(options, 'sys_version', '')

    httpdis.init(options, False)
    DWHO_THREADS.append(httpdis.stop)

    if options.foreground:
        serve(options, user, gid, root_logger, httpdis.KillableThreadingHTTPServer)
    else:
        run_detached(options, user, gid, root_logger)


def serve(options, user, gid, root_logger, server_class):
    LOG.info("locking PID")
    daemonize.lock_pidfile_or_die(options.pidfile)

    try:
        LOG.info("pidfile ok")
        root_logger.setLevel(options.loglevel)
        os.chown(options.pidfile, user.pw_uid, gid)
        if os.geteuid() == 0:
            os.initgroups(user.pw_name, gid)
        os.setgid(gid)
        os.setuid(user.pw_uid)
        os.umask(0o22)

        start_endpoints()
        httpdis.run(options, http_server_class=server_class)
    except KeyboardInterrupt:
        pass
    except Exception:
        LOG.exception("Covenant daemon failed")
        raise SystemExit(1)
    finally:
        daemonize.unlock_pidfile(options.pidfile)

if __name__ == '__main__':
    def _start():
        "entry point"
        options = argv_parse_check()
        if not options.dontlauchmain:
            main(options)
    _start()
